{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm -w run typecheck:libs && pnpm --filter @workspace/web run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/jobs/:jobId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|bingbot|yandex|baiduspider|duckduckbot|slurp|applebot|petalbot|twitterbot|facebookexternalhit|linkedinbot|whatsapp|telegrambot|discordbot|pinterestbot).*"
        }
      ],
      "destination": "https://spay-api.onrender.com/ssr/jobs/:jobId"
    },
    {
      "source": "/jobs",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|bingbot|yandex|baiduspider|duckduckbot|slurp|applebot|petalbot|twitterbot|facebookexternalhit|linkedinbot|whatsapp|telegrambot|discordbot|pinterestbot).*"
        }
      ],
      "destination": "https://spay-api.onrender.com/ssr/jobs"
    },
    {
      "source": "/jobs-sitemap.xml",
      "destination": "https://spay-api.onrender.com/api/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "BASE_PATH": "/"
  }
}
