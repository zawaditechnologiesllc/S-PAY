{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm -w run typecheck:libs && pnpm --filter @workspace/web run build",
  "outputDirectory": "artifacts/web/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/jobs/:jobId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|bingbot|yandex|baiduspider|duckduckbot|slurp|applebot|petalbot|twitterbot|facebookexternalhit|linkedinbot|whatsapp|telegrambot|discordbot|pinterestbot).*"
        }
      ],
      "destination": "https://s-pay.onrender.com/ssr/jobs/:jobId"
    },
    {
      "source": "/jobs",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|bingbot|yandex|baiduspider|duckduckbot|slurp|applebot|petalbot|twitterbot|facebookexternalhit|linkedinbot|whatsapp|telegrambot|discordbot|pinterestbot).*"
        }
      ],
      "destination": "https://s-pay.onrender.com/ssr/jobs"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|bingbot|yandex|baiduspider|duckduckbot|slurp|applebot|petalbot|twitterbot|facebookexternalhit|linkedinbot|whatsapp|telegrambot|discordbot|pinterestbot).*"
        }
      ],
      "destination": "https://s-pay.onrender.com/ssr/blog/:slug"
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|bingbot|yandex|baiduspider|duckduckbot|slurp|applebot|petalbot|twitterbot|facebookexternalhit|linkedinbot|whatsapp|telegrambot|discordbot|pinterestbot).*"
        }
      ],
      "destination": "https://s-pay.onrender.com/ssr/blog"
    },
    {
      "source": "/jobs-sitemap.xml",
      "destination": "https://s-pay.onrender.com/api/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "env": {
    "BASE_PATH": "/"
  }
}
